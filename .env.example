# =============================================================================
# .env.example — Plantilla de variables de entorno
# Proyecto: Sistema Integral de Gestión y Predicción de Insumos
# Imprenta Universitaria UAGRM
#
# INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.example .env
#   2. Reemplazar TODOS los valores de ejemplo con los valores reales
#   3. NUNCA commitear el archivo .env al repositorio
# =============================================================================

# =============================================
# CONFIGURACIÓN GENERAL
# =============================================
ENVIRONMENT=development

# =============================================
# BASE DE DATOS
# =============================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=imprenta_uagrm
POSTGRES_USER=imprenta_user
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION

# URL de conexión completa (usada por SQLAlchemy con driver asyncpg)
DATABASE_URL=postgresql+asyncpg://imprenta_user:CAMBIAR_EN_PRODUCCION@db:5432/imprenta_uagrm

# =============================================
# SEGURIDAD JWT
# =============================================
# Generar con: openssl rand -hex 32
SECRET_KEY=GENERAR_CON_openssl_rand_-hex_32
ALGORITHM=HS256
# Tiempo de expiración del token en minutos (480 = 8 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# =============================================
# BACKEND
# =============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Orígenes permitidos para CORS (separados por coma).
# En producción Azure, incluir la IP pública o el dominio asignado:
# Ej: ALLOWED_ORIGINS=http://localhost:80,https://imprenta.uagrm.edu.bo,http://20.120.50.15
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# =============================================
# FRONTEND
# =============================================
# En producción con Nginx como reverse proxy se usa ruta relativa: /api/v1
# En desarrollo local sin Docker: http://localhost:8000/api/v1
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Imprenta UAGRM

# =============================================
# MACHINE LEARNING
# =============================================
# Ruta donde se almacenan los modelos entrenados (.pkl)
ML_MODEL_PATH=./ml_models/
# Mínimo de registros históricos requeridos para entrenar el modelo
ML_MIN_RECORDS_FOR_TRAINING=50
