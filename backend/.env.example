# =============================================================================
# backend/.env.example — Variables de entorno del Backend (FastAPI)
# Proyecto: Sistema Integral de Gestión y Predicción de Insumos — UAGRM
#
# INSTRUCCIONES:
#   Copiar como .env dentro de backend/ para ejecución local sin Docker.
#   En Docker, las variables se inyectan desde el .env de la raíz del proyecto.
#   NUNCA commitear el archivo .env al repositorio.
# =============================================================================

# =============================================
# ENTORNO
# =============================================
ENVIRONMENT=development

# =============================================
# BASE DE DATOS
# =============================================
# En Docker: usa el nombre del servicio 'db' como host
# En local sin Docker: usa 'localhost'
DATABASE_URL=postgresql+asyncpg://imprenta_user:CAMBIAR@db:5432/imprenta_uagrm

# =============================================
# SEGURIDAD JWT
# =============================================
# Generar con: openssl rand -hex 32
SECRET_KEY=GENERAR_CLAVE_SEGURA_CON_OPENSSL
ALGORITHM=HS256
# Duración del token de acceso en minutos (480 = 8 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# =============================================
# CORS
# =============================================
# Orígenes permitidos separados por coma (sin espacios)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# =============================================
# MACHINE LEARNING
# =============================================
# Ruta donde se guardan los modelos .pkl entrenados
ML_MODEL_PATH=./ml_models/
# Mínimo de registros históricos para entrenar el modelo
ML_MIN_RECORDS_FOR_TRAINING=50
