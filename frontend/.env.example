# =============================================
# VARIABLES DE ENTORNO DEL FRONTEND
# =============================================
# Las variables DEBEN comenzar con VITE_ para ser accesibles en el código.
# Copiar a .env y completar con valores reales.
# NUNCA commitear el archivo .env.

# URL base de la API del backend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Nombre de la aplicación (aparece en el título del navegador)
VITE_APP_NAME=Imprenta Universitaria UAGRM
